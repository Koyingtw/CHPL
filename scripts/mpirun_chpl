#!/usr/bin/env bash
# Launch CHPL with mpirun (Open MPI / HPC-X syntax).
#
#   mpirun_chpl -P <P> -Q <Q> -N <N> [--NB <NB>]
#   mpirun_chpl -P <P> -Q <Q> -i <input>
#
# P selects the solver: P=1,Q=1 -> chpl_single, P=2 -> chpl_p2 (Q=4 or 8),
# P=4 -> chpl_p4 (any Q). The tuned defaults below are applied only to
# variables that are not already set in the environment.
set -euo pipefail

usage() {
  cat <<USAGE
Usage: $(basename "$0") -P <P> -Q <Q> (-N <N> [--NB <NB>] | -i <input>) [options]

  -P <P>          rows in the process grid (1, 2 or 4)
  -Q <Q>          columns in the process grid
  -N <N>          global matrix size
  --NB <NB>       block size (default: 4096; 1024 for P=Q=1)
  -i <input>      HPL.dat-style input file (reads N, NB and threshold)
  --dry-run       print the command instead of running it
  -h, --help      show this help

Environment:
  MPIRUN          MPI launcher (default: mpirun)
  MPIRUN_OPTS     extra launcher options, e.g. "--hostfile hosts"
  CHPL_BIN_DIR    directory holding the chpl_* binaries (default: script dir)
USAGE
}

P=""; Q=""; N=""; NB=""; INPUT=""; DRY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -P) P="$2"; shift 2 ;;
    -Q) Q="$2"; shift 2 ;;
    -N) N="$2"; shift 2 ;;
    --NB|-NB) NB="$2"; shift 2 ;;
    -i) INPUT="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

die() { echo "mpirun_chpl: $*" >&2; exit 1; }
[[ -n "$P" && -n "$Q" ]] || { usage >&2; exit 1; }
[[ -n "$N" || -n "$INPUT" ]] || INPUT="$(dirname "$0")/HPL.dat"
[[ -z "$N" || -z "$INPUT" ]] || die "use either -N or -i, not both"

BIN_DIR="${CHPL_BIN_DIR:-$(cd "$(dirname "$0")" && pwd)}"
MPIRUN="${MPIRUN:-mpirun}"
NP=$((P * Q))

case "$P" in
  1) [[ "$Q" == 1 ]] || die "P=1 is only supported with Q=1 (single GPU)"
     BIN="$BIN_DIR/chpl_single" ;;
  2) [[ "$Q" == 4 || "$Q" == 8 ]] || die "P=2 requires Q=4 or Q=8"
     BIN="$BIN_DIR/chpl_p2" ;;
  4) BIN="$BIN_DIR/chpl_p4"
     (( Q >= 4 )) || echo "mpirun_chpl: warning: P=4 with Q<4 is untested; use -P 2 for one node" >&2 ;;
  *) die "P must be 1, 2 or 4" ;;
esac
[[ -x "$BIN" || "$DRY" == 1 ]] || die "binary not found: $BIN"

# ---- single GPU: chpl_single takes N on the command line ----
if [[ "$P" == 1 ]]; then
  if [[ -n "$INPUT" ]]; then
    N=$(sed -n 6p "$INPUT" | awk '{print $1}')
    NB=$(sed -n 8p "$INPUT" | awk '{print $1}')
  fi
  export HPLS_NB="${NB:-${HPLS_NB:-1024}}"
  export HPLS_AGG="${HPLS_AGG:-8}"
  export HPLS_BACKEND="${HPLS_BACKEND:-gemmul8}"
  export HPLS_G8_MODULI="${HPLS_G8_MODULI:-12}"
  export HPLS_G8_FAST="${HPLS_G8_FAST:-1}"
  export HPLS_G8_CHUNK="${HPLS_G8_CHUNK:-3072}"
  CMD=("$BIN" "$N")
  if [[ "$DRY" == 1 ]]; then
    env | grep '^HPLS_' | sort; echo "${CMD[*]}"; exit 0
  fi
  exec "${CMD[@]}"
fi

# ---- multi-GPU: write an input file when N is given ----
if [[ -n "$N" ]]; then
  NB="${NB:-4096}"
  INPUT="$(mktemp "${TMPDIR:-/tmp}/chpl_HPL.XXXXXX.dat")"
  trap 'rm -f "$INPUT"' EXIT
  cat > "$INPUT" <<DAT
HPLinpack benchmark input file
Innovative Computing Laboratory, University of Tennessee
HPL.out      output file name (if any)
6            device out (6=stdout,7=stderr,file)
1            # of problems sizes (N)
$N           Ns
1            # of NBs
$NB          NBs
0            PMAP process mapping (0=Row-,1=Column-major)
1            # of process grids (P x Q)
$P           Ps
$Q           Qs
16.0         threshold
DAT
fi
[[ -f "$INPUT" ]] || die "input file not found: $INPUT"

# ---- tuned defaults (GEMMul8 backend, NB=4096) ----
if [[ "$P" == 2 ]]; then DEF_NT=2816; DEF_NCH=6; else DEF_NT=3072; DEF_NCH=8; fi
declare -A DEF=(
  [CHPL2D_OZ]=0 [CHPL2D_G8]=1 [CHPL2D_G8_MODULI]=11 [CHPL2D_G8_FAST]=1
  [CHPL2D_G8_NT]=$DEF_NT [CHPL2D_WCH]=4 [CHPL2D_PRESEL]=1
  [CHPL2D_WS]=64 [CHPL2D_XT]=6144
  [NCCL_MAX_NCHANNELS]=$DEF_NCH [NCCL_MIN_NCHANNELS]=1 [NCCL_BUFFSIZE]=2097152
  [CUDA_DEVICE_MAX_CONNECTIONS]=32
)
[[ "$P" == 4 ]] && DEF[CHPL2D_PRESEL2]=1   # read by chpl_p4 only
XFLAGS=()
for v in $(printf '%s\n' "${!DEF[@]}" | sort); do
  export "$v=${!v:-${DEF[$v]}}"
  XFLAGS+=(-x "$v")
done
# forward any other CHPL2D_* / NCCL_* settings the user exported
for v in $(compgen -e | grep -E '^(CHPL2D_|NCCL_)' | sort); do
  [[ -n "${DEF[$v]+x}" ]] || XFLAGS+=(-x "$v")
done
XFLAGS+=(-x LD_LIBRARY_PATH)

# shellcheck disable=SC2206
CMD=("$MPIRUN" -np "$NP" --bind-to none ${MPIRUN_OPTS:-} "${XFLAGS[@]}" "$BIN" "$INPUT")
if [[ "$DRY" == 1 ]]; then
  for v in $(printf '%s\n' "${!DEF[@]}" | sort); do echo "$v=${!v}"; done
  echo "${CMD[*]}"; cat "$INPUT"; exit 0
fi
"${CMD[@]}"
